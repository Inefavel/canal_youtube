  "lines": [
    {
      "id": "l1",
      "speaker": "bolota",
      "text": "Só mais cinco minutinhos...",
      "start": 0.6,
      "end": 2.32
    },
    {
      "id": "l2",
      "speaker": "palito",
      "text": "Bom dia! Relaxa, hoje é sábado. Pode dormir à vontade!",
      "start": 9.4,
      "end": 13.12
    },
    {
      "id": "l3",
      "speaker": "bolota",
      "text": "Sábado?! Melhor notícia da semana!",
      "start": 13.4,
      "end": 16.56
    },
    {
      "id": "l4",
      "speaker": "celular",
      "text": "Lembrete: reunião com o chefe em cinco minutos.",
      "start": 17.8,
      "end": 21.56
    },
    {
      "id": "l5",
      "speaker": "bolota",
      "text": "Reunião?! Hoje é QUINTA?!",
      "tts": "Reunião?! Hoje é quinta?!",
      "start": 21.8,
      "end": 23.89
    },
    {
      "id": "l6",
      "speaker": "palito",
      "text": "Ah... foi mal. Mas pelo menos você descansou!",
      "start": 24.2,
      "end": 27.03
    },
    {
      "id": "l7",
      "speaker": "bolota",
      "text": "...Eu odeio quinta-feira.",
      "start": 27.8,
      "end": 29.61
    }

    {
      "id": "l1",
      "speaker": "maquina",
      "text": "Digite sua senha.",
      "gap": 0.4,
      "offscreen": true
    },
    {
      "id": "l2",
      "speaker": "bolota",
      "text": "Fácil. É o meu aniversário... ou o da minha mãe?",
      "gap": 0.3
    },
    {
      "id": "l3",
      "speaker": "maquina",
      "text": "Senha incorreta. Restam duas tentativas.",
      "gap": 0.4,
      "offscreen": true
    },
    {
      "id": "l4",
      "speaker": "bolota",
      "text": "Então é o aniversário do cachorro!",
      "gap": 0.3
    },
    {
      "id": "l5",
      "speaker": "maquina",
      "text": "Senha incorreta. Cartão bloqueado.",
      "gap": 0.4,
      "offscreen": true
    },
    {
      "id": "l6",
      "speaker": "bolota",
      "text": "BLOQUEADO?! EU NEM TENHO CACHORRO!",
      "gap": 0.2,
      "tts": "Bloqueado?! Eu nem tenho cachorro!"
    },
    {
      "id": "l7",
      "speaker": "palito",
      "text": "Deixa comigo! Paguei com o celular.",
      "gap": 0.6
    },
    {
      "id": "l8",
      "speaker": "palito",
      "text": "Senha do celular: um, dois, três, quatro!",
      "gap": 0.8
    },
    {
      "id": "l9",
      "speaker": "bolota",
      "text": "...Eu odeio senha.",
      "gap": 0.8
    }

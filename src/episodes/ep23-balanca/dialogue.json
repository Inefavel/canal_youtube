      "id": "l1",
      "speaker": "bolota",
      "text": "ERRO?! ATÉ A BALANÇA?!",
      "tts": "Erro?! Até a balança?!",
      "start": 0.15
    },
    {
      "id": "l2",
      "speaker": "bolota",
      "text": "Calma. Tira o relógio. Tira o sapato.",
      "gap": 0.5
    },
    {
      "id": "l3",
      "speaker": "bolota",
      "text": "Tira a meia. Prende a respiração...",
      "gap": 0.3
    },
    {
      "id": "l4",
      "speaker": "bolota",
      "text": "CENTO E VINTE QUILOS?!",
      "gap": 0.8,
      "tts": "Cento e vinte quilos?!"
    },
    {
      "id": "l5",
      "speaker": "palito",
      "text": "Bolota, posso tirar o pé agora?",
      "gap": 0.6
    },
    {
      "id": "l6",
      "speaker": "bolota",
      "text": "Você tava pisando na balança?!",
      "gap": 0.3
    },
    {
      "id": "l7",
      "speaker": "palito",
      "text": "Só pra te dar apoio moral!",
      "gap": 0.3
    },
    {
      "id": "l8",
      "speaker": "bolota",
      "text": "...Eu odeio balança.",
      "gap": 0.8
